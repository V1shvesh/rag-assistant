# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI)
# Use the "connection pooling" string for app runtime; direct connection is fine for local dev.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# OpenAI (for embeddings)
OPENAI_API_KEY=

# Anthropic (for generation)
ANTHROPIC_API_KEY=

# Supabase project URL (Project Settings -> Data API -> Project URL)
# Used to verify Supabase Auth JWTs via the project's JWKS endpoint.
# This project uses asymmetric ES256 signing keys, so no JWT secret is required.
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Comma-separated list of allowed browser origins for CORS.
# Local dev default is the Vite dev server; add the deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173
