# Supabase project URL and anon/public key (Project Settings -> Data API).
# The anon key is designed to be public and safe to ship in a browser
# bundle -- never put a service-role key, or any backend API key, here.
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=

# Base URL of the NestJS backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:3000
